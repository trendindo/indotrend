<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Promo Produk Rekomendasi</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      background: #0f0f0f;
      overflow: hidden;
    }

    /* Splash Screen */
    #splash {
      position: fixed;
      width: 100%;
      height: 100vh;
      background: linear-gradient(135deg, #000000, #1a1a1a);
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 9999;
      animation: fadeOut 1s forwards;
      animation-delay: 1s;
    }

    #splash h1 {
      color: white;
      font-size: 40px;
      text-align: center;
      animation: zoomIn 1s ease;
      text-shadow: 0 0 20px rgba(255,255,255,0.5);
    }

    @keyframes zoomIn {
      from {
        transform: scale(0.5);
        opacity: 0;
      }
      to {
        transform: scale(1);
        opacity: 1;
      }
    }

    @keyframes fadeOut {
      to {
        opacity: 0;
        visibility: hidden;
      }
    }

    /* Main Content */
    .container {
      width: 100%;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      flex-direction: column;
      color: white;
      background: linear-gradient(135deg, #141414, #202020);
      text-align: center;
      padding: 20px;
    }

    .container h2 {
      font-size: 42px;
      margin-bottom: 15px;
    }

    .container p {
      color: #cfcfcf;
      margin-bottom: 30px;
      font-size: 18px;
    }

    .btn {
      padding: 15px 35px;
      background: #ff3c00;
      border: none;
      border-radius: 50px;
      color: white;
      font-size: 18px;
      text-decoration: none;
      transition: 0.3s;
      box-shadow: 0 0 20px rgba(255,60,0,0.5);
    }

    .btn:hover {
      transform: scale(1.05);
      background: #ff5a24;
    }
  </style>
</head>
<body>

  <!-- Splash -->
  <div id="splash">
    <h1>Promo Produk Rekomendasi</h1>
  </div>

  <!-- Main -->
  <div class="container">
    <h2>Produk Viral Terbaik 🔥</h2>
    <p>Temukan produk pilihan dengan promo menarik setiap hari.</p>

    <a href="https://s.shopee.co.id/5L8dm3D5l3" class="btn">Lihat Produk</a>
  </div>

</body>
</html>
